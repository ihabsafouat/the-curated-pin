# ---------- Database ----------
# Runtime: use Neon's pooled connection string and the least-privilege app role.
DATABASE_URL=postgresql://tcp_app:change-me@localhost:5432/curated_pin
# Migrations / provisioning only. Never expose this URL to browser code.
DATABASE_MIGRATION_URL=
DATABASE_ADMIN_URL=
APP_DATABASE_USER=tcp_app
APP_DATABASE_PASSWORD=replace-with-a-long-random-database-password

# ---------- Authentication & request security ----------
JWT_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-a-different-long-random-secret
EMAIL_PREFERENCE_SECRET=replace-with-another-32-plus-character-secret
EMAIL_CRON_SECRET=replace-with-another-32-plus-character-secret
ADMIN_EMAIL=the-curated-pin@gmail.com
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Consent-based analytics ----------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# ---------- Bot protection ----------
# NEXT_PUBLIC values are intentionally public. The Turnstile secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Transactional email / password resets + audience sequences ----------
RESEND_API_KEY=
# Free Resend testing sender: delivery is limited to your Resend account email.
# Replace this with your own verified-domain sender when public email launches.
MAIL_FROM=The Curated Pin <onboarding@resend.dev>
MAIL_REPLY_TO=the-curated-pin@gmail.com


# ---------- Editorial media / Cloudinary ----------
# Server-only credentials except the cloud name embedded in delivery URLs.
# Use a SIGNED upload preset. Never expose CLOUDINARY_API_SECRET with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=tcp_editorial_signed


# ---------- Digital product checkout links ----------
# Create the products in your checkout provider, then paste the public checkout URLs here.
CHECKOUT_URL_ULTIMATE_BIRTHDAY_PARTY_PLANNER=
CHECKOUT_URL_TEEN_BIRTHDAY_PARTY_PLANNER=

# ---------- Commerce conversion webhooks ----------
# Server-to-server only. Never expose this value to browser code.
CONVERSION_WEBHOOK_SECRET=

# ---------- AI safety posture ----------
# No AI endpoint is enabled in Priority 5. Keep false/0 until an AI feature has a
# dedicated threat model, per-user quota, prompt-size cap and output validation.
AI_FEATURES_ENABLED=false
AI_DAILY_REQUEST_LIMIT=0
