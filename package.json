{
  "name": "the-curated-pin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "eslint .",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:migrate:postgres": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "typecheck": "tsc --noEmit",
    "user:promote": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/promote-user.mjs",
    "env:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-env.mjs",
    "db:check": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-postgres.mjs",
    "seo:seed:birthday": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-birthday-seo.mjs",
    "seo:simulate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seo-simulate.mjs",
    "setup:priority2": "npm run db:migrate && npm run seo:seed:birthday && npm run seo:simulate",
    "setup:priority3": "npm run db:migrate && npm run seo:seed:birthday && npm run seo:simulate",
    "setup:priority4": "npm run db:migrate && npm run seo:seed:birthday && npm run seo:simulate",
    "setup:priority5": "npm run db:migrate && npm run seo:seed:birthday && npm run seo:simulate",
    "db:provision-app-role": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/provision-app-role.mjs",
    "audience:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-audience.mjs",
    "setup:priority6": "npm run db:migrate && npm run seo:seed:birthday && npm run audience:seed && npm run seo:simulate",
    "email:dispatch": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dispatch-email-sequences.mjs",
    "setup:priority7": "npm run db:migrate && npm run seo:seed:birthday && npm run audience:seed && npm run seo:simulate",
    "setup:priority8": "npm run db:migrate && npm run seo:seed:birthday && npm run audience:seed && npm run seo:simulate",
    "setup:priority9": "npm run db:migrate && npm run seo:seed:birthday && npm run audience:seed && npm run seo:simulate",
    "maintenance": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/maintenance.mjs",
    "prod:audit": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/production-audit.mjs",
    "smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-test.mjs",
    "setup:priority10": "npm run db:migrate && npm run seo:seed:birthday && npm run audience:seed && npm run seo:simulate && npm run prod:audit",
    "launch:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-launch-content.mjs --status=draft",
    "launch:publish": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/publish-launch-content.mjs",
    "growth:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-growth-content.mjs",
    "growth:publish": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/publish-growth-content.mjs --all --confirm=publish-reviewed-growth",
    "pinterest:csv": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/generate-pinterest-csv.mjs",
    "setup:priority11": "npm run db:migrate && npm run seo:seed:birthday && npm run audience:seed && npm run launch:seed && npm run seo:simulate && npm run prod:audit"
  },
  "dependencies": {
    "animejs": "4.5.0",
    "lenis": "1.3.26",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
